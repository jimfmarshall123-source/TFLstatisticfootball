# These are set automatically when you connect an Upstash Redis database
# to this project from the Vercel dashboard (Storage -> Browse Marketplace
# -> Upstash). You should NOT need to fill these in by hand — Vercel injects
# them into your deployment's environment automatically.
#
# They're listed here only so `vercel dev` (local development) knows what
# to expect. If you want to run this locally, copy this file to `.env.local`
# and paste in the real values from your Vercel project's Settings -> 
# Environment Variables page.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
